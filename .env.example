NODE_ENV=production
HOST=127.0.0.1
PORT=8103
POS_DB_PATH=/home/ubuntu/projects/light-pos/sqlite.db
POS_RECEIPT_PARSER_URL=

# Every account created in production requires an environment password of at
# least 12 characters. Existing password hashes are never reset on startup.
POS_ADMIN_PASSWORD=replace-with-a-long-random-password
POS_CASHIER_HARBOR_PASSWORD=replace-with-a-long-random-password
POS_MANAGER_HARBOR_PASSWORD=replace-with-a-long-random-password
POS_KITCHEN_HARBOR_PASSWORD=replace-with-a-long-random-password
POS_DISPLAY_HARBOR_PASSWORD=replace-with-a-long-random-password
POS_CASHIER_GARDEN_PASSWORD=replace-with-a-long-random-password
POS_MANAGER_GARDEN_PASSWORD=replace-with-a-long-random-password
POS_KITCHEN_GARDEN_PASSWORD=replace-with-a-long-random-password
POS_DISPLAY_GARDEN_PASSWORD=replace-with-a-long-random-password
POS_CASHIER_NORTH_PASSWORD=replace-with-a-long-random-password
POS_MANAGER_NORTH_PASSWORD=replace-with-a-long-random-password
POS_KITCHEN_NORTH_PASSWORD=replace-with-a-long-random-password
POS_DISPLAY_NORTH_PASSWORD=replace-with-a-long-random-password
POS_MANAGER_MULTI_PASSWORD=replace-with-a-long-random-password
